{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Database": {
    "Provider": "SqlServer"
  },
  "Jwt": {
    "Issuer": "MangaStore",
    "Audience": "MangaStore",
    "Secret": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "App": {
    "FrontendBaseUrl": "http://localhost:3000"
  },
  "Identity": {
    "SeedAdmin": {
      "Email": "",
      "Password": "",
      "DisplayName": "Administrator"
    }
  },
  "Cors": {
    "AllowedOrigins": [ "*" ]
  },
  "FeatureManagement": {},
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName" ]
  },
  "AllowedHosts": "*"
}
