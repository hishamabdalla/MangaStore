<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Mapping (AutoMapper 13+ includes DI extensions; no separate package needed) -->
    <PackageVersion Include="AutoMapper" Version="16.1.1" />

    <!-- Validation -->
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />

    <!-- EF Core -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.5" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.5" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.5" />
    <!-- Test-only: the integration suite runs on SQLite in-memory. The app itself is SQL Server only. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.5" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.5" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.5" />

    <!-- Transitive override: EF Core Sqlite 10.0.5 pulls SQLitePCLRaw 2.1.11, which carries
         the high-severity advisory GHSA-2m69-gcr7-jv3q. Referenced explicitly in
         MangaStore.IntegrationTests to force the patched build. Remove once EF Core ships a
         version that resolves 2.1.13 or later on its own. -->
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.13" />
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />

    <!-- Outbound HTTP resilience: Polly v8 wrapped by Microsoft. Preferred over raw Polly or the
         legacy Microsoft.Extensions.Http.Polly, which is deprecated. -->
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.9.0" />

    <!-- DI scanning -->
    <PackageVersion Include="Scrutor" Version="5.0.0" />

    <!-- Logging -->
    <PackageVersion Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="6.0.0" />

    <!-- API versioning -->
    <PackageVersion Include="Asp.Versioning.Http" Version="8.1.1" />
    <PackageVersion Include="Asp.Versioning.Mvc" Version="8.1.1" />
    <PackageVersion Include="Asp.Versioning.Mvc.ApiExplorer" Version="8.1.1" />

    <!-- OpenAPI / Swagger / Scalar -->
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="7.3.1" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.4.2" />


    <!-- Auth (part of the ASP.NET Core shared framework — no download needed) -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.5" />

    <!-- Identity: user/role stores, password hashing, lockout, reset tokens.
         Version tracks EF Core so the two agree on Microsoft.EntityFrameworkCore. -->
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.5" />

    <!-- Token issuance. 8.19.1 is what JwtBearer 10.0.5 resolves; pinning it here keeps
         the issuing and validating sides on one version of the handler. -->
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.19.1" />

    <!-- Test -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="Shouldly" Version="4.2.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.5" />
  </ItemGroup>

</Project>
